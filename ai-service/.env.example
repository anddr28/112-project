# ai-service — переменные окружения (значения по умолчанию; в compose задаются в compose.ai.yaml).
INTERNAL_API_TOKEN=dev-internal-token      # общий секрет с go-core (X-Internal-Token в обе стороны)
GO_CORE_URL=http://go-core:8080            # callback: GO_CORE_URL + /internal/ai/v1/results
# CALLBACK_URL=                            # полный URL callback'а (перекрывает GO_CORE_URL)
OLLAMA_URL=http://ollama:11434
LANGUAGETOOL_URL=http://languagetool:8010
# LLM_MODEL=qwen2.5:7b-instruct            # одна модель на все LLM-профили (иначе — config/models.yaml)
# LLM_THINK=false                          # выключить «thinking» (gemma4, qwen3); пусто — не отправлять
OLLAMA_KEEP_ALIVE=30m
LLM_CONCURRENCY=1                          # слотов полосы LLM (>1 — только вместе с OLLAMA_NUM_PARALLEL)
LT_CONCURRENCY=4
MODELS_DIR=/models                         # веса whisper/silero (запечены в образ при WITH_VOICE=1)
TTS_DIR=/data/tts                          # shared volume tts_cache с go-core
VOICE_ENGINES=auto                         # off — не грузить голосовые движки
STT_ENGINE=faster_whisper
STT_MAX_AUDIO_SEC=60
STT_MAX_BYTES=2097152
CPU_THREADS=4
DIALOG_DEADLINE_SEC=18                     # бюджет хода диалога (< таймаута go-core settings.ai.dialog_timeout_sec)
DIALOG_MAX_WAITING=8                       # ждущих ходов диалога больше -> 503 + Retry-After
DIALOG_HISTORY_TURNS=8
QUEUE_MAX_SEMANTIC=200
QUEUE_MAX_GRAMMAR=500
QUEUE_MAX_GENERATE=20
QUEUE_MAX_TTS=200
QUEUE_MAX_DIALOGUE=200
CALLBACK_RETRIES=1,5,30
WARMUP=true                                # прогрев LLM и служебной фразы TTS при старте
LOG_LEVEL=info
LOG_FORMAT=json                            # text — для локальной отладки
