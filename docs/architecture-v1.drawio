<mxfile host="drawio"><diagram name="architecture-v1.4"><mxGraphModel dx="1800" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Тренажёр оператора ДДС (эмуляция АРМ-112) — компонентная архитектура · v1.4" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1900" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Изолированный локальный контур учебного центра · без доступа в интернет · TLS внутри контура · docker compose (Ubuntu 20.04+ / Windows 10-11)" style="text;html=1;fontSize=13;fontColor=#555555;align=left;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="1900" height="24" as="geometry"/></mxCell><mxCell id="c4" value="ЛОКАЛЬНЫЙ КОНТУР · docker compose «lct112»" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=right;spacingRight=14;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#B85450;fillColor=none;strokeColor=#B85450;strokeWidth=2;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="80" width="1900" height="1000" as="geometry"/></mxCell><mxCell id="c5" value="КЛИЕНТЫ · браузер (Chrome / Firefox / Яндекс) · ПК, планшет, телефон в ЛВС" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="300" height="560" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Администратор&lt;/b&gt;&lt;br&gt;пользователи и роли, блокировка · состояние контура · настройки · аудит · системный журнал · бэкапы" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#B85450;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c5"><mxGeometry x="15" y="60" width="270" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Преподаватель&lt;/b&gt;&lt;br&gt;генерация и утверждение сценариев · занятия · live-мониторинг · отчёты · аналитика и инсайты · справочная база" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#B85450;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c5"><mxGeometry x="15" y="190" width="270" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Обучающийся&lt;/b&gt;&lt;br&gt;приём вызова (голос/текст) · карточка АРМ-112 · ракурс ДДС · таймер норматива · результаты · прогресс · сертификат" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#B85450;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c5"><mxGeometry x="15" y="320" width="270" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;SPA&lt;/b&gt; React 19 + TypeScript · буфер отправки (outbox, clientSeq) · WS-клиент с since · MediaRecorder (гарнитура)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c5"><mxGeometry x="15" y="465" width="270" height="80" as="geometry"/></mxCell><mxCell id="c10" value="GO-CORE · модульный монолит на Go 1.26 · :8443 HTTPS (SPA + REST + WSS) · :8080 внутр. (callback, health, metrics)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="120" width="760" height="560" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;auth · users&lt;/b&gt;&lt;br&gt;сессии (httpOnly cookie), argon2id, rate limit, lockout, RBAC, CSRF; учётки, прогресс, сертификат PDF" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#6C8EBF;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c10"><mxGeometry x="15" y="45" width="238" height="112" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;classifier · reaction&lt;/b&gt;&lt;br&gt;классификатор (XLSX→JSON), опросные карты, службы, адреса; граф статусов реагирования" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#6C8EBF;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c10"><mxGeometry x="263" y="45" width="238" height="112" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;scenarios&lt;/b&gt;&lt;br&gt;сценарии, версии эталонов, генерация через AI, утверждение, TTS-кэш, импорт/экспорт, карточка ученика → сценарий" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#6C8EBF;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c10"><mxGeometry x="511" y="45" width="238" height="112" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;lessons · attempts&lt;/b&gt;&lt;br&gt;занятия, выдача карточек, ракурс ДДС, черновик (upsert), события (group commit, clientSeq), сдача" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#6C8EBF;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c10"><mxGeometry x="15" y="170" width="238" height="112" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;dialogue&lt;/b&gt;&lt;br&gt;ход разговора с заявителем (синхронно), fallback по легенде, транскрипт" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#6C8EBF;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c10"><mxGeometry x="263" y="170" width="238" height="112" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;evaluation · scoring · dds&lt;/b&gt;&lt;br&gt;слои поля / тайминг / протокол ДДС; сбор AI-слоёв; итог, вердикт, XP, ручная корректировка" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#6C8EBF;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c10"><mxGeometry x="511" y="170" width="238" height="112" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;aijobs&lt;/b&gt;&lt;br&gt;очередь AI-задач в PostgreSQL, диспетчер, reaper, circuit breaker, приём callback" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#6C8EBF;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c10"><mxGeometry x="15" y="295" width="238" height="112" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;realtime · eventlog&lt;/b&gt;&lt;br&gt;WebSocket-хаб: мониторинг занятия, канал попытки; since + буфер 5 мин" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#6C8EBF;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c10"><mxGeometry x="263" y="295" width="238" height="112" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;reports · analytics&lt;/b&gt;&lt;br&gt;отчёты CSV/XLSX/PDF; тепловая карта ошибок, динамика, инсайты" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#6C8EBF;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c10"><mxGeometry x="511" y="295" width="238" height="112" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;materials&lt;/b&gt;&lt;br&gt;справочная база: Markdown + файлы (PDF, DOCX, MP3/WAV…)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#6C8EBF;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c10"><mxGeometry x="15" y="420" width="238" height="112" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;audit · admin&lt;/b&gt;&lt;br&gt;аудит (партиции, ≥6 мес), настройки, журнал, состояние контура" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#6C8EBF;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c10"><mxGeometry x="263" y="420" width="238" height="112" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;ops&lt;/b&gt;&lt;br&gt;TLS (CA контура), бэкапы pg_dump по расписанию, SPA-статика, /healthz /readyz /metrics" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#6C8EBF;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c10"><mxGeometry x="511" y="420" width="238" height="112" as="geometry"/></mxCell><mxCell id="c23" value="AI-SERVICE · Python 3.11 · FastAPI · :8000 (только из go-core)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1330" y="120" width="540" height="560" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Задачи «поставил и забыл»&lt;/b&gt;&lt;br&gt;/v1/jobs/generate · semantic · grammar · dialogue · tts → 202, результат — callback в go-core" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#D6B656;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c23"><mxGeometry x="15" y="45" width="240" height="120" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Синхронные (голос)&lt;/b&gt;&lt;br&gt;/v1/dialog/turn — LLM-заявитель&lt;br&gt;/v1/stt/transcribe&lt;br&gt;/v1/tts/sync" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#D6B656;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c23"><mxGeometry x="265" y="45" width="240" height="120" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Приоритетная очередь LLM&lt;/b&gt;: диалог &amp;gt; оценка &amp;gt; генерация · 503 + Retry-After при перегрузке · промпты с версиями · балл считает Python по формуле" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#D6B656;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c23"><mxGeometry x="15" y="175" width="490" height="70" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Ollama&lt;/b&gt; :11434&lt;br&gt;Qwen2.5-7B-Instruct (q4)&lt;br&gt;JSON-режим" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c23"><mxGeometry x="15" y="260" width="240" height="90" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;LanguageTool&lt;/b&gt;&lt;br&gt;ru-RU, self-hosted&lt;br&gt;орфография, пунктуация, стиль" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c23"><mxGeometry x="265" y="260" width="240" height="90" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Silero TTS v4&lt;/b&gt; (ru, CPU)&lt;br&gt;голос заявителя, кэш по хэшу реплики" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c23"><mxGeometry x="15" y="370" width="240" height="90" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;faster-whisper&lt;/b&gt; (ru, CPU)&lt;br&gt;распознавание речи оператора; аудио не хранится" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c23"><mxGeometry x="265" y="370" width="240" height="90" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;fakeai&lt;/b&gt; (Go) — имитатор ai-service по контракту: стенд и e2e-тесты без моделей (compose-профиль fake)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontFamily=Helvetica;" vertex="1" parent="c23"><mxGeometry x="15" y="470" width="510" height="70" as="geometry"/></mxCell><mxCell id="c32" value="POSTGRESQL 16 (совместимо с 12+) · единственное хранилище состояния" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="450" y="720" width="760" height="330" as="geometry"/></mxCell><mxCell id="c33" value="users · auth_sessions" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c32"><mxGeometry x="15" y="45" width="174" height="50" as="geometry"/></mxCell><mxCell id="c34" value="services · classifier_categories" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c32"><mxGeometry x="199" y="45" width="174" height="50" as="geometry"/></mxCell><mxCell id="c35" value="scenarios · etalons (версии)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c32"><mxGeometry x="383" y="45" width="174" height="50" as="geometry"/></mxCell><mxCell id="c36" value="tts_cache · materials" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c32"><mxGeometry x="567" y="45" width="174" height="50" as="geometry"/></mxCell><mxCell id="c37" value="lessons · lesson_participants" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c32"><mxGeometry x="15" y="107" width="174" height="50" as="geometry"/></mxCell><mxCell id="c38" value="attempts · attempt_drafts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c32"><mxGeometry x="199" y="107" width="174" height="50" as="geometry"/></mxCell><mxCell id="c39" value="attempt_events (batch)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c32"><mxGeometry x="383" y="107" width="174" height="50" as="geometry"/></mxCell><mxCell id="c40" value="evaluations · xp_ledger" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c32"><mxGeometry x="567" y="107" width="174" height="50" as="geometry"/></mxCell><mxCell id="c41" value="teacher_feedback · recommendations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c32"><mxGeometry x="15" y="169" width="174" height="50" as="geometry"/></mxCell><mxCell id="c42" value="ai_jobs (очередь AI)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c32"><mxGeometry x="199" y="169" width="174" height="50" as="geometry"/></mxCell><mxCell id="c43" value="audit_log (партиции)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c32"><mxGeometry x="383" y="169" width="174" height="50" as="geometry"/></mxCell><mxCell id="c44" value="backups · settings" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#9673A6;fontFamily=Helvetica;" vertex="1" parent="c32"><mxGeometry x="567" y="169" width="174" height="50" as="geometry"/></mxCell><mxCell id="c45" value="UUIDv7 · черновик без индексов (fillfactor 50, HOT) · события пакетами 50 мс + unique(attempt_id, client_seq) · VIEW прогресса · миграции goose 00001–00005" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=11;fillColor=#ffffff;strokeColor=#9673A6;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c32"><mxGeometry x="15" y="240" width="730" height="75" as="geometry"/></mxCell><mxCell id="c46" value="VOLUMES И ЭКСПЛУАТАЦИЯ" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1330" y="720" width="540" height="330" as="geometry"/></mxCell><mxCell id="c47" value="• &lt;b&gt;pgdata&lt;/b&gt; — данные PostgreSQL&lt;br&gt;• &lt;b&gt;backups&lt;/b&gt; — ежедневный pg_dump -Fc + SHA-256, ротация&lt;br&gt;• &lt;b&gt;tls&lt;/b&gt; — CA контура и серверный сертификат&lt;br&gt;• &lt;b&gt;tts_cache&lt;/b&gt; — озвучка реплик (общий go-core ↔ ai-service)&lt;br&gt;• &lt;b&gt;ollama_models&lt;/b&gt; — веса LLM (переносятся офлайн)&lt;br&gt;&lt;br&gt;healthcheck + restart: unless-stopped у всех сервисов&lt;br&gt;журналы — JSON в stdout (json-file, ротация)&lt;br&gt;метрики Prometheus: /metrics" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#666666;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c46"><mxGeometry x="15" y="45" width="490" height="270" as="geometry"/></mxCell><mxCell id="c48" value="КОНТРАКТЫ (источник истины)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fillColor=#B0E3E6;strokeColor=#0E8088;strokeWidth=2;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="300" height="330" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;contracts/openapi/&lt;/b&gt;&lt;br&gt;• frontend.v1.yaml (v1.4) — SPA ↔ go-core, camelCase, REST + WS&lt;br&gt;• ai-service.v1.yaml — go-core → ai-service&lt;br&gt;• go-internal.v1.yaml — callback ai-service → go-core&lt;br&gt;• _components.yaml — общие схемы&lt;br&gt;&lt;br&gt;&lt;b&gt;make generate&lt;/b&gt; → типы Go (oapi-codegen), Python (pydantic), TypeScript&lt;br&gt;&lt;br&gt;Тест покрытия маршрутов против спеки; HTML-документация docs/api/" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=12;fillColor=#ffffff;strokeColor=#0E8088;dashed=0;fontFamily=Helvetica;" vertex="1" parent="c48"><mxGeometry x="15" y="45" width="270" height="270" as="geometry"/></mxCell><mxCell id="c50" value="HTTPS / WSS :8443" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;