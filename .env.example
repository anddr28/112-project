# Корневой .env для docker compose (скопировать в .env; сам .env — в .gitignore).
POSTGRES_PASSWORD=lct
# Общий секрет go-core <-> ai-service (X-Internal-Token в обе стороны). В стенде — сменить!
INTERNAL_API_TOKEN=dev-internal-token
# Демо-учётки (teacher/teacher, student/student, admin/admin) и демо-данные при старте.
GOCORE_DEMO_MODE=true
GOCORE_LOG_LEVEL=info
# Имена/IP, на которые выписывается сертификат контура (SAN), через запятую.
GOCORE_TLS_HOSTS=localhost,127.0.0.1,go-core
GOCORE_HTTPS_PORT=8443
GOCORE_HTTP_PORT=8080
# Имитатор ai-service: множитель задержек (0 — мгновенно).
FAKEAI_SPEED=1
