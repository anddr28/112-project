# Сервисный слой: по умолчанию mock — стенд работает без backend.
# false — HTTP по contracts/openapi/frontend.v1.yaml (go-core, /api/v1).
VITE_USE_MOCKS=true

# Только для VITE_USE_MOCKS=false: куда dev-сервер проксирует /api и WebSocket.
VITE_API_PROXY=https://localhost:8443

# Базовый путь публичного API (servers.url контракта).
VITE_API_BASE=/api/v1
